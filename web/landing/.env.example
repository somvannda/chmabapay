NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical origin for absolute URLs that metadata has to bake at build time —
# `og:image` and `twitter:image`. Unset falls back to https://pay.chmaba.com,
# which is correct for the production image; `robots.ts` and `sitemap.ts` do not
# need it because they are rendered per request from the request's own origin.
NEXT_PUBLIC_SITE_URL=https://pay.chmaba.com
