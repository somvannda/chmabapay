# Copy to .env and adjust.
# Phase 1 POC defaults to SQLite (no services needed). For Postgres use docker compose
# and point DATABASE_URL at it.

# sqlite (default)
DATABASE_URL=sqlite+aiosqlite:///./chmabapay.db
# postgres via the compose database. 55432, not 5432 — importantly so, because the compose
# database is published off the default port precisely so it cannot collide with a Postgres
# already running on the host. `docker compose up -d db redis` starts the backing services
# alone; `docker compose up -d` starts the whole stack (see docs/deploy.md).
# DATABASE_URL=postgresql+asyncpg://chmaba:chmaba@localhost:55432/chmabapay

# Fake rail mounted at /_dev: POST /_dev/payments/{id}/pay marks a payment paid without
# money moving, and GET /auth/_dev/login mints a real session cookie for whatever email
# is named — neither is behind a credential. The application's default is OFF; this file
# is the *development* template, so it turns the rail back on. Do not carry this value
# into a real deployment. The compose stack ignores it either way: docker-compose.yml
# hardcodes ENABLE_DEV_GATEWAY false rather than reading it from here.
ENABLE_DEV_GATEWAY=true
# Background loops (outbox delivery, expiry, retention). Set to false only when another
# process drains the same queue — the app refuses to start otherwise, because with the
# in-process transport nothing would ever consume what this process enqueues.
WORKERS_ENABLED=true

# --------------------------------------------------------------------------- #
# Shared queue (P2-3)
# --------------------------------------------------------------------------- #
# Where jobs are queued, and whether this process drains them. Two switches because a
# process can need to enqueue without consuming: with the drains in their own process
# the API still posts jobs and reports queue depth, while the worker does the draining.
#
#   inprocess (default) — one asyncio queue, no external dependency, one API replica.
#   redis               — a Redis Streams queue, so several processes can share the work.
#
# Split topology (see docs/deploy.md):
#   WORKER_TRANSPORT=redis WORKERS_ENABLED=false   # on the API
#   WORKER_TRANSPORT=redis                         # on `python -m chmabapay.worker_main`
WORKER_TRANSPORT=inprocess

# Read only when WORKER_TRANSPORT=redis. 56379, not 6379: this machine answers 6379 with
# a native Redis 3.0.504 for Windows, which has no streams (`XADD` is Redis 5) and no
# `HELLO` (Redis 6). `docker compose` publishes the container on 56379 for that reason.
REDIS_URL=redis://localhost:56379/0

# How long a dedup key suppresses duplicate work. Outlives the job deliberately, so a
# job that has just finished still blocks an immediate duplicate.
QUEUE_DEDUP_TTL_SECONDS=3600

# How long an unacknowledged job may sit before another worker assumes its consumer
# died and takes it over. Must exceed the slowest legitimate job; webhook delivery is
# capped by WEBHOOK_TIMEOUT_SECONDS, so 60s leaves a wide margin.
QUEUE_CLAIM_IDLE_SECONDS=60

# --------------------------------------------------------------------------- #
# Rate limiting + CORS (P1-1)
# --------------------------------------------------------------------------- #
# Per-minute ceilings, one per path class; see src/chmabapay/ratelimit.py for what
# each one counts against. Counters live in this process, so they bound a single
# replica — the same constraint the in-process workers carry until P2-3.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20            # /auth/*, /api/v1/auth/* — brute-force target
RATE_LIMIT_CHECKOUT_PER_MINUTE=120       # /pay/* — the public checkout page
RATE_LIMIT_KHQR_PER_MINUTE=60            # /v1/khqr/* — unauthenticated, reaches ABA
RATE_LIMIT_API_PER_MINUTE=600            # the rest of /v1/*, per API key
RATE_LIMIT_PAYMENT_CREATE_PER_MINUTE=60  # mints an ABA session, per API key

# Set RATE_LIMIT_ENABLED=false to run /_dev/integration-test: 1272 cases in a
# minute is abuse-shaped by construction and would be refused with 429.

# Browser origins allowed to call this API, comma-separated. When empty this
# falls back to PUBLIC_ORIGIN plus localhost URLs on a dev deployment, and an
# empty result means no cross-origin browser access at all. Never set this to
# "*": the wildcard is deliberately gone, and browsers reject "*" combined with
# credentials. Server-to-server callers (the usual POS integration) are
# unaffected — CORS is a browser mechanism.
CORS_ALLOWED_ORIGINS=

# Optional: where the CLI-bootstrapped shared webhook posts events
# (point at a local sink, e.g. https://webhook.site or a small collector).
WEBHOOK_SINK_URL=

# --------------------------------------------------------------------------- #
# Sessions, Google OAuth, and post-login routing (required in production)
# --------------------------------------------------------------------------- #
# Signs the `chmabapay_session` cookie. There is deliberately no usable default: the
# built-in placeholder is published in this repository, so the app refuses to start on
# it — or on an empty value — rather than warning about it. Generate one and paste it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_TTL_SECONDS=86400

# Google OAuth. Leave the redirect URI empty to let the backend derive it from
# the request (Cloudflare X-Forwarded-Proto/Host), or set it to the exact value
# registered in the GCP Console — Google compares it byte for byte.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Canonical public origin, e.g. https://pay.chmaba.com. When set, it wins over
# the forwarded headers for the OAuth redirect URI and secure-cookie decisions.
PUBLIC_ORIGIN=

# Where a user lands after the OAuth callback / dev login. Default "/" points at
# the FastAPI root, so in a split deployment set the landing origin instead.
POST_LOGIN_REDIRECT_URL=/

# --------------------------------------------------------------------------- #
# Platform operator + billing self-pay
# --------------------------------------------------------------------------- #
# Comma-separated emails auto-promoted to platform admin + business on their
# first Google sign-in. Grants /v1/admin/* and seeds the HQ store.
CHMABAPAY_ADMIN_EMAILS=

# ChmabaPay's own store, used to collect plan fees (dog-fooding create_payment).
# Accepts Store.id or Store.public_id; falls back to the first admin account's
# first active store. Without it, self-pay invoices cannot produce a QR.
CHMABAPAY_HQ_STORE_ID=
CHMABAPAY_HQ_PAYWAY_LINK=

# --------------------------------------------------------------------------- #
# Bakong Open API (transaction verification via hash / md5 lookup)
# Reverse-engineered from https://api-bakong.nbc.gov.kh/
# --------------------------------------------------------------------------- #
# Base URL for the Bakong Open API (NBC gateway). Defaults to the public URL.
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh

# Short-lived JWT issued by the NBC. Either supply it directly, or provide a
# registered developer email so the client can auto-mint it via /v1/renew_token
# (and auto-refresh on HTTP 401). You only need one of the two below.
BAKONG_API_TOKEN=
BAKONG_DEVELOPER_EMAIL=

# HTTP tuning
BAKONG_TIMEOUT_SECONDS=10
BAKONG_MAX_RETRIES=3

# Bakong payment reconciliation: how often (seconds) to poll pending/scanned
# payments against the ledger via MD5-of-QR, and the max attempts per payment
# before giving up (it will be expired by its own TTL anyway).
BAKONG_POLL_INTERVAL_SECONDS=2
BAKONG_POLL_MAX_ATTEMPTS=60

# --------------------------------------------------------------------------- #
# Merchant alerts (Telegram)
# --------------------------------------------------------------------------- #
# Token of the bot that delivers store alerts, from @BotFather. A store stores
# only its `telegram_chat_id`; this token is what turns that id into a delivered
# message. Without it nothing can be sent, so
# POST /v1/stores/{id}/telegram/test answers 503 telegram_not_configured instead
# of reporting a success that never happened.
TELEGRAM_BOT_TOKEN=

# --------------------------------------------------------------------------- #
# Observability: metrics and the operator alerts (P1-3)
# --------------------------------------------------------------------------- #
# Prometheus exposition at GET /metrics, network-wide volumes by route, payment
# outcome and queue. Left empty it is served unauthenticated — convenient for a
# local scrape, and a disclosure of platform-wide volumes in production, so the
# app logs a warning at startup when it is unset. Set it and the endpoint
# requires `Authorization: Bearer <token>`; restrict the path at the proxy too.
METRICS_TOKEN=

# Where operator alerts are delivered, over the bot above. A chat id, not a
# username: get it from @userinfobot, or from the bot's own getUpdates. Without
# it — or without a token — nothing is paged and the only trace of an alert is a
# log line, which the watcher states at startup rather than leaving you to assume
# coverage you do not have.
OPS_TELEGRAM_CHAT_ID=

# How often the alert conditions are evaluated, how long a queue may go without
# its drain loop asking for work, and how many webhook deliveries may pile up
# before that counts as a backlog. A healthy loop asks every ~0.05s, so the
# stall threshold is about "the loop is gone", not "the loop is busy".
ALERT_INTERVAL_SECONDS=30
ALERT_WORKER_STALL_SECONDS=60
ALERT_WEBHOOK_BACKLOG=50

# The backlog threshold above only sees a queue that is not draining. A rail that is
# draining and *failing* — a merchant endpoint refusing every POST — keeps its
# deliveries moving, so nothing piles up and only the failure ratio moves. This
# alerts on that: the share of delivery attempts that failed over the window, and
# the number of attempts below which the ratio is not trusted (one failure out of
# one must not page).
ALERT_WEBHOOK_FAILURE_RATE=0.1
ALERT_WEBHOOK_FAILURE_WINDOW_SECONDS=900
ALERT_WEBHOOK_FAILURE_MIN_SAMPLE=20

# --------------------------------------------------------------------------- #
# Compliance: merchant agreement + retention (P1-4)
# --------------------------------------------------------------------------- #
# The published version of the merchant agreement. Recorded against an account
# when it accepts, so this must be bumped whenever the text of /terms changes —
# otherwise an account that accepted the previous draft is indistinguishable from
# one that accepted the current text, and re-acceptance can never be required.
TERMS_VERSION=1

# Raw payment-rail responses (`payments.gateway_status_raw`) carry the ABA
# session token verbatim. Sessions live about a minute, so keeping them forever
# accumulates credentials for no benefit. A daily sweep deletes them once a
# payment is older than this. Only that column is cleared — amounts, references
# and the QR survive as the accounting record. See docs/legal/data-retention.md.
#
# A non-positive value DISABLES the purge rather than purging everything: a `0`
# that silently read as "delete all history" is the one misconfiguration this
# must not turn into an outage.
RETENTION_GATEWAY_RAW_DAYS=90
RETENTION_SWEEP_INTERVAL_SECONDS=86400
