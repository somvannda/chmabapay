# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Node / pnpm
node_modules/
.pnpm-store/

# Next.js
.next/
out/
next-env.d.ts

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local runtime
.env
.env.*
!.env.example
!**/.env.example
# The local Docker stack's env file. `.env.*` above would swallow its template —
# which is the one file here that is supposed to be committed, since it carries no
# values and is what a fresh clone copies to get a working stack.
!**/.env.local.example
*.db
*.sqlite3
# Runtime logs. `.backend.log` and the web apps' `.server.log` files carry request
# paths and headers, so they are local artefacts, never history.
*.log
probe-config.json
findings.json

# Secrets — OAuth client secrets downloaded from the GCP console
client_secret_*.json
chmabapay.json

# TLS material for the production origin (deploy/docker-compose.prod.yml mounts it at
# /etc/nginx/certs). A Cloudflare Origin CA private key is a long-lived credential;
# committing one is not recoverable by rewriting history.
deploy/certs/
*.pem
*.key

# Local binaries
_bin/

# Builds
dist/
build/
*.tsbuildinfo
