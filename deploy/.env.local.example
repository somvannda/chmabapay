# Environment for the local *full stack* — docker-compose.yml at the repository root.
#
#   cp deploy/.env.local.example deploy/.env.local     # then fill in the blanks
#   docker compose --env-file deploy/.env.local up -d --build
#
# `--env-file` is not optional, and it is the whole point of this file existing.
# Without it, `docker compose` interpolates the repository-root `.env` — which is the
# *host* file, written for a process running on the host with a database of its own.
# That is how a container ends up told its public origin is `http://localhost:3001`
# (the host dev server, not running) and its admin bootstrap is a host CLI's values.
#
# The three files, and what each one is for:
#
#   .env                      host runs (`uv run uvicorn`) — no container involved
#   deploy/.env.local         THIS one: the local stack, everything in containers
#   deploy/.env               production, read by deploy/docker-compose.prod.yml
#
# They are not interchangeable, and `assert_runtime_matches_configuration` in
# src/chmabapay/config.py refuses to boot when one is used for another. See
# docs/deploy.md §2.
#
# gitignored, like every real .env here: this holds a JWT signing key and an OAuth
# client secret. This template is committed on purpose — it has no values.

# --------------------------------------------------------------------------- #
# Which runtime this file is for — required
# --------------------------------------------------------------------------- #
# Read by the application's boot guard, and required by docker-compose.yml, so a
# bare `docker compose up` (no --env-file) fails at parse time instead of quietly
# starting the stack off the host's .env.
CHMABAPAY_RUNTIME=docker

# --------------------------------------------------------------------------- #
# Sessions and identity
# --------------------------------------------------------------------------- #
# Signs the `chmabapay_session` cookie. The application refuses to boot on the
# built-in placeholder, so generate one even locally:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# The canonical origin of THIS stack. The edge is on :8080, so that is the origin —
# not :3001, which is where the host dev server would be. It decides the OAuth
# redirect URI and whether the session cookie is marked Secure.
PUBLIC_ORIGIN=http://localhost:8080
# Where a user lands after the callback. "/" is the FastAPI root, not the site.
POST_LOGIN_REDIRECT_URL=http://localhost:8080/dashboard

# Google sign-in. GOOGLE_REDIRECT_URI must be registered in the GCP Console byte for
# byte, including the port — a localhost:3001 entry does not authorise :8080.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/user/google/auth/callback

# Leave empty: the fallback is PUBLIC_ORIGIN, and browsers on :8080 reach this API
# same-origin through the proxy. Never "*" — browsers reject it with credentials,
# and the wildcard was removed deliberately.
CORS_ALLOWED_ORIGINS=

# --------------------------------------------------------------------------- #
# The fake payment rail — ON here, and only here
# --------------------------------------------------------------------------- #
# Mounts /_dev, where POST /_dev/payments/{id}/pay marks a payment paid without
# money moving, and GET /auth/_dev/login mints a real session for any email named,
# with no credential. Without it a local stack has no way to settle a payment at
# all — there is no Bakong token to poll with.
#
# This is safe to turn on *because* this file exists: only this file can supply it,
# and `deploy/docker-compose.prod.yml` hardcodes it off regardless. It must stay
# false in any stack reachable from outside this machine.
ENABLE_DEV_GATEWAY=true

# --------------------------------------------------------------------------- #
# Platform operator + billing self-pay
# --------------------------------------------------------------------------- #
# Comma-separated addresses auto-promoted to platform admin on their first sign-in.
# The console is password-only (Google sessions are refused), so also create the
# password with the CLI:
#   docker compose --env-file deploy/.env.local exec api \
#     python -m chmabapay.cli grant-admin you@example.com --password '<password>'
CHMABAPAY_ADMIN_EMAILS=
CHMABAPAY_ADMIN_PASSWORD=
# ChmabaPay's own store, where plan fees are collected. Normally set from the admin
# console (Settings -> "Plan fee collection") rather than here.
CHMABAPAY_HQ_STORE_ID=
CHMABAPAY_HQ_PAYWAY_LINK=

# --------------------------------------------------------------------------- #
# Money — Bakong
# --------------------------------------------------------------------------- #
# Only needed to reconcile against the real ledger. Empty locally: the dev rail is
# what settles payments here, and a live token has no business in a dev stack.
BAKONG_API_TOKEN=
BAKONG_DEVELOPER_EMAIL=

# --------------------------------------------------------------------------- #
# Alerting and billing email — deliberately empty locally
# --------------------------------------------------------------------------- #
# A live bot token and a live Resend key are *production* credentials: with either
# set, a local stack pages the real ops chat and emails real merchants. The in-app
# dunning banner needs no provider, so nothing is lost by leaving it off. Put real
# values only in a throwaway chat or a test key.
TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
ACTIVITY_TELEGRAM_CHAT_ID=
RESEND_API_KEY=
BILLING_EMAIL_FROM=billing@chmaba.com

# --------------------------------------------------------------------------- #
# Optional overrides — the defaults are correct for local work
# --------------------------------------------------------------------------- #
# LOG_LEVEL=info
# WORKER_TRANSPORT=inprocess        # or `redis` with the `workers` profile
# API_WORKERS_ENABLED=true
# METRICS_TOKEN=
# PAYWAY_PROXY_URL=
# BILLING_LEAD_DAYS=7
# BILLING_GRACE_DAYS=7
# BILLING_ENFORCE_ENABLED=false
