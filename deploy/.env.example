# Production environment for deploy/docker-compose.prod.yml.
#
#   cp deploy/.env.example deploy/.env      # then fill in every blank
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --build
#
# deploy/.env is gitignored, and must stay that way: it holds the JWT signing key,
# the database password and the Telegram bot token. This template is committed on
# purpose — it has no values in it.
#
# This is **not** a copy of the repository-root `.env.example`. That one is a
# development template: it sets ENABLE_DEV_GATEWAY=true, which mounts a fake payment
# rail and a session-minting login route. Nothing here does, and neither value is
# read by the production compose file, which hardcodes the rail off. Per-variable
# reasoning lives in .env.example and docs/deploy.md; this is the checklist.

# --------------------------------------------------------------------------- #
# Required — compose refuses to start without these three
# --------------------------------------------------------------------------- #
# Signs the `chmabapay_session` cookie. There is no usable default: the built-in
# placeholder is published in this repository, so the application refuses to boot on
# it. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# The database password. The development stack uses `chmaba:chmaba`; this stack has
# no publicly reachable database port, but that value reaching production is the kind
# of thing that stays invisible until the day it matters.
POSTGRES_PASSWORD=
POSTGRES_USER=chmaba
POSTGRES_DB=chmabapay

# The canonical origin. It wins over the forwarded headers for the OAuth redirect URI
# and for whether the session cookie is marked Secure. Left empty it would be inferred
# from the edge — set it so it is a decision rather than an inference.
PUBLIC_ORIGIN=https://pay.chmaba.com

# --------------------------------------------------------------------------- #
# Identity — Google sign-in
# --------------------------------------------------------------------------- #
# Google compares GOOGLE_REDIRECT_URI byte for byte against what is registered in the
# GCP Console. The callback is served by the API:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pay.chmaba.com/auth/google/callback

# Where the user lands after the callback. The default "/" is the FastAPI root, not
# the website, so in a split deployment this has to point at the site.
POST_LOGIN_REDIRECT_URL=https://pay.chmaba.com/dashboard

# Browser origins allowed to call this API. Never "*" — it is gone deliberately, and
# browsers reject it combined with credentials. Server-to-server callers are
# unaffected; CORS is a browser mechanism.
CORS_ALLOWED_ORIGINS=https://pay.chmaba.com,https://admin-pay.chmaba.com

# --------------------------------------------------------------------------- #
# Alerting — without these two, nothing is ever paged
# --------------------------------------------------------------------------- #
# TELEGRAM_BOT_TOKEN is the bot from @BotFather; OPS_TELEGRAM_CHAT_ID is the numeric
# chat id an operator alert goes to (a chat id, not a username).
#
# The chat must have sent **/start** to the bot first. A bot cannot open a
# conversation, and Telegram answers HTTP 200 with `{"ok": false, ...}` when it is
# asked to — so a wrong chat id looks like a healthy request and delivers nothing.
# See docs/deploy.md §5.
#
# The same bot can serve both operator alerts here and per-store merchant alerts
# (each store holds its own chat id); the ids differ, the token is shared.
TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=

# The activity feed: settled payments, raised plan invoices and unhandled exceptions,
# posted to a Telegram *group* so a team can watch the platform. Separate from
# OPS_TELEGRAM_CHAT_ID, which is one person's chat.
#
# A group id is negative (e.g. -1001234567890). A bot cannot be added to a group by
# invite link or open a conversation itself, so invite the bot, send a message in the
# group, then read the id off with:
#     docker compose exec api python -m chmabapay.cli telegram-chat-id
# Empty switches the feed off; activity is still logged and alerted normally.
ACTIVITY_TELEGRAM_CHAT_ID=

# --------------------------------------------------------------------------- #
# Plan-fee billing clock
# --------------------------------------------------------------------------- #
# How long before a period ends its renewal invoice is raised, and how long after that
# invoice is due the account is frozen for non-payment. Platform-wide rather than
# per-plan, and read from the environment only — the console has no switch for either.
BILLING_LEAD_DAYS=7
BILLING_GRACE_DAYS=7

# Enforcement is deliberately off. Deploy, watch a full D-7 -> D+6 cycle with the
# notices showing, and only then set this true — so the first account frozen is one the
# platform demonstrably warned. While it is false a non-payer is reminded and never
# frozen, and the candidates are reported in the job log on every run.
BILLING_ENFORCE_ENABLED=false

# --------------------------------------------------------------------------- #
# Billing reminders by email (Resend)
# --------------------------------------------------------------------------- #
# The dunning tiers merchants already see in the dashboard, delivered to the account
# address as well. Optional: with no key the channel is simply off, and nothing is
# lost — the in-app banner is derived from `due_at` and needs no provider.
#
# BILLING_EMAIL_FROM must be on a domain verified in the Resend account, or Resend
# rejects the send with 403. Rows are keyed (invoice_id, tier, channel), so turning
# this on mid-cycle emails the tier a merchant is currently at and never re-sends
# the history; a failed send is recorded with the reason rather than retried, which
# is why a delivery error shows up in the job summary as `email_failed`.
RESEND_API_KEY=
# A display name is allowed and worth setting — a dunning mail is judged on whether
# the recipient recognises it: ChmabaPay Billing <billing@chmaba.com>
BILLING_EMAIL_FROM=billing@chmaba.com

# Outbound proxy for the ABA PayWay fetches ONLY, e.g.
#   PAYWAY_PROXY_URL=http://user:pass@proxy-host:3128
#
# ABA answers 403 Forbidden to some host egress ranges while serving the same page 200
# from an ordinary connection, which breaks QR minting and PayWay link verification on
# an otherwise healthy deployment. Set this to route just the ABA hop through an
# address ABA accepts. Empty means a direct connection.
PAYWAY_PROXY_URL=

# If unset, GET /metrics is served unauthenticated. It is not routed at the edge, so
# this is the second line of defence rather than the only one. Set it anyway.
#
# The monitoring agent below also reads this: it scrapes /metrics over the compose
# network with it, so with `--profile monitoring` this must be set.
METRICS_TOKEN=

# --------------------------------------------------------------------------- #
# Monitoring — the Prometheus agent that forwards /metrics to Grafana Cloud
# --------------------------------------------------------------------------- #
# Nothing here is read unless the stack is started with `--profile monitoring`, and
# that is deliberate: the default `up -d --build` must not depend on a third-party
# account. See docs/deploy.md §13.
#
# Where these come from: sign in at grafana.com, open your stack, then the
# **Prometheus** tile → "Send metrics". The page shows the `.../api/prom/push` URL,
# the numeric **metrics instance ID** next to it, and a **Generate now** button for
# an API token. Generate the token with the `metrics:write` scope.
#
# The username is an identifier, not a secret. The token is a secret and belongs
# only in deploy/.env, never in the repository.
GRAFANA_REMOTE_WRITE_URL=
GRAFANA_METRICS_USERNAME=
GRAFANA_METRICS_TOKEN=

# --------------------------------------------------------------------------- #
# Money — Bakong transaction verification
# --------------------------------------------------------------------------- #
# Either a short-lived JWT from the NBC, or a registered developer email the client
# can mint one from (and re-mint on 401). One of the two is enough.
BAKONG_API_TOKEN=
BAKONG_DEVELOPER_EMAIL=

# --------------------------------------------------------------------------- #
# Platform operator + billing self-pay
# --------------------------------------------------------------------------- #
# The reliable way to create the first operator is the CLI — it needs no OAuth
# round trip and works on an empty database:
#
#   docker compose -f deploy/docker-compose.prod.yml exec api \
#     python -m chmabapay.cli grant-admin duke@chmaba.com --password '<real password>'
#
# The two variables below are the older, weaker path and do not replace it:
# CHMABAPAY_ADMIN_EMAILS only promotes an account on a Google sign-in — and the
# console refuses Google sessions, so you still need the CLI to set a password —
# while CHMABAPAY_ADMIN_PASSWORD only supplies one on an existing admin account's
# first password login. Setting all three is fine; setting only these two is not
# enough to open the console.
CHMABAPAY_ADMIN_EMAILS=
CHMABAPAY_ADMIN_PASSWORD=
# ChmabaPay's own store, where plan fees are collected. Both variables are optional.
#
# The supported way to set this is the admin console — Settings → "Plan fee collection".
# Saving there creates the platform's own store if none exists, marks it internal (so its
# takings are not metered as a merchant's) and needs no restart. Set a variable here only
# to pin a deployment by hand.
#
# Which store wins, when both are configured (`services/billing.resolve_hq_store`):
#
#   1. CHMABAPAY_HQ_STORE_ID — a store id (`st_…`) or a row id. It wins over the console,
#      which is why the console reports which source is in use: an operator who has just
#      saved a link needs to see that the environment variable is the one collecting.
#   2. If this is empty, the console-resolved store wins: the store named `ChmabaPay HQ`
#      owned by a platform admin. Named, not "the admin's own store", so plan fees cannot
#      land in an operator's unrelated business store.
#   3. With no console store either, a platform admin's first active store, for
#      deployments configured before the console had the field.
#
# A pinned id that does not resolve is not an error: the search simply falls through to
# (2). With none of the three found, paying an invoice answers 503 billing_not_open.
CHMABAPAY_HQ_STORE_ID=
# Seeds the store above on the platform admin's next sign-in. It takes precedence over
# whatever link the console saved for that store, so it is the same kind of pin as the id.
CHMABAPAY_HQ_PAYWAY_LINK=

# --------------------------------------------------------------------------- #
# Optional overrides — the defaults are correct for launch
# --------------------------------------------------------------------------- #
# LOG_LEVEL=info
# JWT_TTL_SECONDS=86400
# RATE_LIMIT_ENABLED=true
