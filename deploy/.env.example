# Production environment for deploy/docker-compose.prod.yml.
#
#   cp deploy/.env.example deploy/.env      # then fill in every blank
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --build
#
# deploy/.env is gitignored, and must stay that way: it holds the JWT signing key,
# the database password and the Telegram bot token. This template is committed on
# purpose — it has no values in it.
#
# This is **not** a copy of the repository-root `.env.example`. That one is a
# development template: it sets ENABLE_DEV_GATEWAY=true, which mounts a fake payment
# rail and a session-minting login route. Nothing here does, and neither value is
# read by the production compose file, which hardcodes the rail off. Per-variable
# reasoning lives in .env.example and docs/deploy.md; this is the checklist.

# --------------------------------------------------------------------------- #
# Required — compose refuses to start without these three
# --------------------------------------------------------------------------- #
# Signs the `chmabapay_session` cookie. There is no usable default: the built-in
# placeholder is published in this repository, so the application refuses to boot on
# it. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# The database password. The development stack uses `chmaba:chmaba`; this stack has
# no publicly reachable database port, but that value reaching production is the kind
# of thing that stays invisible until the day it matters.
POSTGRES_PASSWORD=
POSTGRES_USER=chmaba
POSTGRES_DB=chmabapay

# The canonical origin. It wins over the forwarded headers for the OAuth redirect URI
# and for whether the session cookie is marked Secure. Left empty it would be inferred
# from the edge — set it so it is a decision rather than an inference.
PUBLIC_ORIGIN=https://pay.chmaba.com

# --------------------------------------------------------------------------- #
# Identity — Google sign-in
# --------------------------------------------------------------------------- #
# Google compares GOOGLE_REDIRECT_URI byte for byte against what is registered in the
# GCP Console. The callback is served by the API:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pay.chmaba.com/auth/google/callback

# Where the user lands after the callback. The default "/" is the FastAPI root, not
# the website, so in a split deployment this has to point at the site.
POST_LOGIN_REDIRECT_URL=https://pay.chmaba.com/dashboard

# Browser origins allowed to call this API. Never "*" — it is gone deliberately, and
# browsers reject it combined with credentials. Server-to-server callers are
# unaffected; CORS is a browser mechanism.
CORS_ALLOWED_ORIGINS=https://pay.chmaba.com,https://admin-pay.chmaba.com

# --------------------------------------------------------------------------- #
# Alerting — without these two, nothing is ever paged
# --------------------------------------------------------------------------- #
# TELEGRAM_BOT_TOKEN is the bot from @BotFather; OPS_TELEGRAM_CHAT_ID is the numeric
# chat id an operator alert goes to (a chat id, not a username).
#
# The chat must have sent **/start** to the bot first. A bot cannot open a
# conversation, and Telegram answers HTTP 200 with `{"ok": false, ...}` when it is
# asked to — so a wrong chat id looks like a healthy request and delivers nothing.
# See docs/deploy.md §5.
#
# The same bot can serve both operator alerts here and per-store merchant alerts
# (each store holds its own chat id); the ids differ, the token is shared.
TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=

# If unset, GET /metrics is served unauthenticated. It is not routed at the edge, so
# this is the second line of defence rather than the only one. Set it anyway.
METRICS_TOKEN=

# --------------------------------------------------------------------------- #
# Money — Bakong transaction verification
# --------------------------------------------------------------------------- #
# Either a short-lived JWT from the NBC, or a registered developer email the client
# can mint one from (and re-mint on 401). One of the two is enough.
BAKONG_API_TOKEN=
BAKONG_DEVELOPER_EMAIL=

# --------------------------------------------------------------------------- #
# Platform operator + billing self-pay
# --------------------------------------------------------------------------- #
# Comma-separated emails auto-promoted to platform admin on first sign-in. Also what
# creates the HQ store that plan fees are collected through.
CHMABAPAY_ADMIN_EMAILS=
CHMABAPAY_ADMIN_PASSWORD=
# ChmabaPay's own store, used to charge plan fees. Without an HQ PayWay link, a
# self-pay invoice cannot produce a QR.
CHMABAPAY_HQ_STORE_ID=
CHMABAPAY_HQ_PAYWAY_LINK=

# --------------------------------------------------------------------------- #
# Optional overrides — the defaults are correct for launch
# --------------------------------------------------------------------------- #
# LOG_LEVEL=info
# JWT_TTL_SECONDS=86400
# RATE_LIMIT_ENABLED=true
